# Copie este archivo a .env y complete los valores en su máquina.
# Las contraseñas de abajo son solo para la demostración local.
# No las reutilice fuera de ese entorno y no las deje vacías si va a
# recorrer el flujo de inicio de sesión.

APP_ENV=development
SEED_ON_STARTUP=true

POSTGRES_USER=ecologistica
POSTGRES_PASSWORD=ecologistica
POSTGRES_DB=ecologistica

# Desde el host hacia el Postgres de Docker Compose (publicado en 5433).
# Compose reescribe DATABASE_URL de la API a db:5432 dentro de la red.
# Si usa un PostgreSQL instalado en el host, vuelva ambos URL al puerto 5432.
DATABASE_URL=postgresql+psycopg://ecologistica:ecologistica@localhost:5433/ecologistica
TEST_DATABASE_URL=postgresql+psycopg://ecologistica:ecologistica@localhost:5433/ecologistica_test

# Clave local de firma JWT. Cámbiela; no es un secreto de producción.
JWT_SECRET=cambie-esta-clave-en-local
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173

# Usuarios de demostración. La contraseña debe tener al menos 8 caracteres.
# Si la deja vacía, la carga inicial omite ese usuario.
SEED_ADMIN_EMAIL=admin@distrirapido.example.com
SEED_ADMIN_PASSWORD=
SEED_OPERADOR_EMAIL=operador@distrirapido.example.com
SEED_OPERADOR_PASSWORD=
SEED_GERENTE_EMAIL=gerente@distrirapido.example.com
SEED_GERENTE_PASSWORD=
